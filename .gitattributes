# Normalize text files to LF on every platform.
* text=auto eol=lf

# Binary assets must keep their original bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.mp4 binary
*.webm binary
