{
  "name": "keytotwo-hero-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "npm run typecheck && react-router build && node scripts/seo-files.mjs",
    "preview": "sirv build/client --host 127.0.0.1 --port 4174 --single __spa-fallback.html",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --ignore-pattern build/** --ignore-pattern .react-router/**",
    "assets:prepare": "node scripts/prepare-hero-assets.mjs",
    "verify:hero": "node scripts/verify-hero.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@react-router/node": "8.4.0",
    "@supabase/supabase-js": "2.117.3",
    "@tabler/icons-react": "3.48.0",
    "isbot": "^5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "markdown-it": "14.3.2",
    "sharp": "^0.35.5",
    "sirv-cli": "3.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "yaml": "2.9.1"
  }
}
