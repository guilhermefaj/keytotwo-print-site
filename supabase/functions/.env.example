# Variáveis das Edge Functions do KeyToTwo.
# Uso local: copie para supabase/functions/.env (ignorado pelo git); a CLI lê no supabase start.
# Valores: só do modelo de segredos (fora do repositório). Nunca commitar valores.
# Na nuvem: `supabase secrets set`, só com autorização da tarefa.
# SUPABASE_URL e as chaves do Supabase são injetadas pela plataforma e pela CLI. Não declare aqui.

# Origens do site que podem chamar a função api (CORS), separadas por vírgula, sem barra no fim.
# Sem valor, nenhuma origem de navegador é aceita.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:5176,http://127.0.0.1:4174,http://127.0.0.1:5178,http://127.0.0.1:5179

# Site: base do return_url do Checkout (local: o frontend de dev).
SITE_URL=http://127.0.0.1:5176
# Admin: base dos links do e-mail de alerta dos admins (local: o admin de dev).
ADMIN_URL=http://127.0.0.1:5179
# Versão vigente dos termos (sem reembolso) mostrada na página de checkout.
TERMS_VERSION=

# Stripe em MODO DE TESTE (I3). O Price de cada produto fica em products.stripe_price_id, no banco de cada ambiente.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Backblaze B2 (I4): SÓ a chave de LEITURA do bucket. A de escrita nunca entra nas funções.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_READ_KEY_ID=
B2_READ_APPLICATION_KEY=

# Blog (2026-10-23): bucket PÚBLICO das imagens do blog e uma chave de escrita restrita a ele (mesma região do B2_ENDPOINT).
B2_BLOG_BUCKET=
B2_BLOG_KEY_ID=
B2_BLOG_APPLICATION_KEY=

# Links HMAC dos e-mails (/d/{token}): 32 bytes aleatórios ou mais. O anterior (opcional) só verifica, na rotação.
EMAIL_LINK_SECRET=
EMAIL_LINK_SECRET_PREVIOUS=
# Base pública da api nos links dos e-mails (no local, obrigatória).
API_PUBLIC_URL=http://127.0.0.1:54321/functions/v1/api

# E-mail. EMAIL_MODE: log (padrão; nada sai, cópia no Mailpit local) ou plunk (envio real pelo Plunk na VPS, que usa
# o Amazon SES; desde 2026-10-31).
EMAIL_MODE=log
# Mailpit da stack local, visto de dentro da rede do Docker.
EMAIL_LOG_MAILPIT_URL=http://supabase_inbucket_keytotwo-print-site:8025
# Só em teste com EMAIL_MODE=plunk: destinatários permitidos, separados por vírgula. Vazio na produção.
EMAIL_ALLOWED_RECIPIENTS=
# Plunk: a API (https://api.email.keytotwo.com.br) e a chave secreta do projeto (sk_…). Com as duas, a exclusão de
# conta apaga o contato no Plunk, em qualquer modo.
PLUNK_API_URL=
PLUNK_SECRET_KEY=
# ses-events: o tópico SNS dos avisos do Amazon SES (arn:aws:sns:us-east-2:<conta>:plunk-ses-events).
SES_EVENTS_TOPIC_ARN=
# Alertas dos admins direto pelo Amazon SES (2026-11-01), sem passar pelo Plunk: o usuário IAM supabase-ses-alertas,
# que só envia como EMAIL_FROM. Sem as três, os alertas saem pelo Plunk. Só valem no modo plunk.
SES_ALERTS_REGION=
SES_ALERTS_ACCESS_KEY_ID=
SES_ALERTS_SECRET_ACCESS_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# plunk-webhook: token Bearer do passo de webhook da automação "Descadastro no Plunk". 32 bytes aleatórios ou mais.
PLUNK_WEBHOOK_SECRET=
