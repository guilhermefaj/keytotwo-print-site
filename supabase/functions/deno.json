{
  "imports": {
    "@supabase/auth-js": "npm:@supabase/auth-js@2.117.2",
    "stripe": "npm:stripe@22.0.2",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "lock": false,
  "tasks": {
    "test:all": "deno run --no-lock --allow-read --allow-env --allow-run tests/run-all.ts all",
    "test:contract": "deno run --no-lock --allow-read --allow-env --allow-run tests/run-all.ts contract",
    "test:integration": "deno run --no-lock --allow-read --allow-env --allow-run tests/run-all.ts integration"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  }
}
